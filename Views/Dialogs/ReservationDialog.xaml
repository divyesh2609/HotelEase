<Window x:Class="HotelEase.Views.Dialogs.ReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservation Details" Height="650" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushCanvasBackground}">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock x:Name="TxtTitle" Text="Create New Reservation" Style="{StaticResource TextHeader2}" />
                <TextBlock Text="Select guest, stay duration, and allocate an available room" Style="{StaticResource TextSubtitle}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Guest Selection -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Select Guest *" Style="{StaticResource TextLabel}" />
                        <ComboBox x:Name="CmbGuest" Style="{StaticResource ModernComboBox}" DisplayMemberPath="DisplayText" />
                    </StackPanel>

                    <!-- Check-in & Check-out Dates -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Check-In Date *" Style="{StaticResource TextLabel}" />
                            <DatePicker x:Name="DpCheckIn" Style="{StaticResource ModernDatePicker}" SelectedDateChanged="OnDatesOrRoomChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Check-Out Date *" Style="{StaticResource TextLabel}" />
                            <DatePicker x:Name="DpCheckOut" Style="{StaticResource ModernDatePicker}" SelectedDateChanged="OnDatesOrRoomChanged" />
                        </StackPanel>
                    </Grid>

                    <!-- Room Filter & Available Rooms Dropdown -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Filter Room Type" Style="{StaticResource TextLabel}" />
                            <ComboBox x:Name="CmbTypeFilter" Style="{StaticResource ModernComboBox}" SelectionChanged="OnTypeFilterChanged">
                                <ComboBoxItem Content="All Types" IsSelected="True" />
                                <ComboBoxItem Content="Standard" />
                                <ComboBoxItem Content="Deluxe" />
                                <ComboBoxItem Content="Suite" />
                                <ComboBoxItem Content="Family" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Available Room *" Style="{StaticResource TextLabel}" />
                            <ComboBox x:Name="CmbRoom" Style="{StaticResource ModernComboBox}" DisplayMemberPath="DisplayText" SelectionChanged="OnDatesOrRoomChanged" />
                        </StackPanel>
                    </Grid>

                    <!-- Guests count & Nights (Auto-calculated) -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Number of Guests *" Style="{StaticResource TextLabel}" />
                            <TextBox x:Name="TxtNumGuests" Text="1" Style="{StaticResource ModernTextBox}" TextChanged="OnCalculationInputsChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Duration (Nights)" Style="{StaticResource TextLabel}" />
                            <TextBox x:Name="TxtNights" Text="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Background="#F1F5F9" />
                        </StackPanel>
                    </Grid>

                    <!-- Pricing & Calculation Card -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Rate Per Night ($)" Style="{StaticResource TextLabel}" />
                                    <TextBox x:Name="TxtRate" Text="0.00" Style="{StaticResource ModernTextBox}" TextChanged="OnCalculationInputsChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Discount ($)" Style="{StaticResource TextLabel}" />
                                    <TextBox x:Name="TxtDiscount" Text="0.00" Style="{StaticResource ModernTextBox}" TextChanged="OnCalculationInputsChanged" />
                                </StackPanel>
                            </Grid>

                            <!-- Calculated Summary -->
                            <Separator Background="{StaticResource BrushBorder}" Margin="0,6,0,10" />
                            <Grid>
                                <TextBlock Text="Total Estimated Amount:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock x:Name="TxtTotalAmount" Text="$0.00" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushAccentTeal}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Special Requests -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Special Requests / Notes" Style="{StaticResource TextLabel}" />
                        <TextBox x:Name="TxtRequests" Style="{StaticResource ModernTextBox}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" Click="OnCancelClick" Margin="0,0,10,0" />
                <Button Content="Confirm Booking" Style="{StaticResource PrimaryButton}" Width="140" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
