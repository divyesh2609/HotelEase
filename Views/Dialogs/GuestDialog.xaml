<Window x:Class="HotelEase.Views.Dialogs.GuestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guest Information" Height="480" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushCanvasBackground}">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="TxtTitle" Text="Register New Guest" Style="{StaticResource TextHeader2}" />
                <TextBlock Text="Enter the contact and identification details for the guest" Style="{StaticResource TextSubtitle}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Full Name -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Full Name *" Style="{StaticResource TextLabel}" />
                        <TextBox x:Name="TxtFullName" Style="{StaticResource ModernTextBox}" />
                    </StackPanel>

                    <!-- Phone & Email -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phone Number *" Style="{StaticResource TextLabel}" />
                            <TextBox x:Name="TxtPhone" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email Address *" Style="{StaticResource TextLabel}" />
                            <TextBox x:Name="TxtEmail" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                    </Grid>

                    <!-- Address -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Residential Address" Style="{StaticResource TextLabel}" />
                        <TextBox x:Name="TxtAddress" Style="{StaticResource ModernTextBox}" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />
                    </StackPanel>

                    <!-- ID Reference -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="ID Reference (Optional DL / Passport #)" Style="{StaticResource TextLabel}" />
                        <TextBox x:Name="TxtIdReference" Style="{StaticResource ModernTextBox}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" Click="OnCancelClick" Margin="0,0,10,0" />
                <Button Content="Save Guest" Style="{StaticResource PrimaryButton}" Width="110" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
