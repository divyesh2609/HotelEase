<Window x:Class="HotelEase.Views.Dialogs.RoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Details" Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushCanvasBackground}">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="TxtTitle" Text="Add New Room" Style="{StaticResource TextHeader2}" />
                <TextBlock Text="Enter the room details and pricing specifications below" Style="{StaticResource TextSubtitle}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Room Number & Type -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Room Number *" Style="{StaticResource TextLabel}" />
                            <TextBox x:Name="TxtRoomNumber" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Room Type *" Style="{StaticResource TextLabel}" />
                            <ComboBox x:Name="CmbRoomType" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Standard" IsSelected="True" />
                                <ComboBoxItem Content="Deluxe" />
                                <ComboBoxItem Content="Suite" />
                                <ComboBoxItem Content="Family" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Floor & Capacity -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Floor Number *" Style="{StaticResource TextLabel}" />
                            <TextBox x:Name="TxtFloor" Text="1" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Capacity (Guests) *" Style="{StaticResource TextLabel}" />
                            <TextBox x:Name="TxtCapacity" Text="2" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                    </Grid>

                    <!-- Price Per Night & Status -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Price Per Night ($) *" Style="{StaticResource TextLabel}" />
                            <TextBox x:Name="TxtPrice" Text="80.00" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Current Status *" Style="{StaticResource TextLabel}" />
                            <ComboBox x:Name="CmbStatus" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Available" IsSelected="True" />
                                <ComboBoxItem Content="Reserved" />
                                <ComboBoxItem Content="Occupied" />
                                <ComboBoxItem Content="Maintenance" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Room Description &amp; Amenities" Style="{StaticResource TextLabel}" />
                        <TextBox x:Name="TxtDescription" Style="{StaticResource ModernTextBox}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" Click="OnCancelClick" Margin="0,0,10,0" />
                <Button Content="Save Room" Style="{StaticResource PrimaryButton}" Width="110" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
