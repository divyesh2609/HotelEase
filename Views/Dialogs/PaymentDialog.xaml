<Window x:Class="HotelEase.Views.Dialogs.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Payment" Height="480" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushCanvasBackground}">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Process Payment Transaction" Style="{StaticResource TextHeader2}" />
                <TextBlock Text="Select a reservation with an outstanding balance and record payment" Style="{StaticResource TextSubtitle}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <!-- Reservation Selection -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Select Reservation *" Style="{StaticResource TextLabel}" />
                    <ComboBox x:Name="CmbReservation" Style="{StaticResource ModernComboBox}" SelectionChanged="OnReservationSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedOption}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Amount & Method -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Payment Amount ($) *" Style="{StaticResource TextLabel}" />
                        <TextBox x:Name="TxtAmount" Text="0.00" Style="{StaticResource ModernTextBox}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Payment Method *" Style="{StaticResource TextLabel}" />
                        <ComboBox x:Name="CmbMethod" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="Card" IsSelected="True" />
                            <ComboBoxItem Content="Cash" />
                            <ComboBoxItem Content="UPI" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Payment Status -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Payment Status *" Style="{StaticResource TextLabel}" />
                    <ComboBox x:Name="CmbStatus" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="Paid" IsSelected="True" />
                        <ComboBoxItem Content="Partially Paid" />
                        <ComboBoxItem Content="Pending" />
                    </ComboBox>
                </StackPanel>

                <!-- Transaction Reference / Notes -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Transaction Reference / Notes" Style="{StaticResource TextLabel}" />
                    <TextBox x:Name="TxtNotes" Style="{StaticResource ModernTextBox}" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />
                </StackPanel>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" Click="OnCancelClick" Margin="0,0,10,0" />
                <Button Content="Record Payment" Style="{StaticResource PrimaryButton}" Width="130" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
