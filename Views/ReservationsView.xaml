<UserControl x:Class="HotelEase.Views.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Controls: Search, Filters & Action Buttons -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Tag="Search by ref, guest, phone, or room..." />

                <!-- Filter by Status -->
                <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilters}" 
                          SelectedItem="{Binding SelectedStatusFilter}" Style="{StaticResource ModernComboBox}" />

                <!-- Action Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushPrimaryNavy}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewReservationCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="New Reservation" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Reservations DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding ReservationsView}" SelectedItem="{Binding SelectedReservation}" Style="{StaticResource ModernDataGrid}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reference #" Binding="{Binding BookingReference}" Width="130" FontWeight="SemiBold" />

                        <DataGridTemplateColumn Header="Guest Details" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding GuestName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding GuestPhone}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Room" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding RoomNumber, StringFormat={}Room {0}}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RoomType}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Stay Duration" Binding="{Binding FormattedDates}" Width="*" />
                        
                        <DataGridTemplateColumn Header="Financials" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Bal: " FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding BalanceAmount, Converter={StaticResource CurrencyConverter}}" FontSize="11" FontWeight="SemiBold" 
                                                       Foreground="{Binding BalanceAmount, Converter={StaticResource CurrencyConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Booking Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Left"
                                            Background="{Binding BookingStatus, Converter={StaticResource StatusToBrushConverter}}">
                                        <TextBlock Text="{Binding BookingStatus}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding BookingStatus, Converter={StaticResource StatusToForegroundConverter}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="Actions" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- Check In Button (Visible only for Confirmed) -->
                                        <Button Style="{StaticResource SecondaryButton}" Padding="7,4" Margin="0,0,5,0"
                                                Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="Check In Guest">
                                            <Path Data="{StaticResource IconCheckIn}" Fill="{StaticResource BrushSuccess}" Width="11" Height="11" Stretch="Uniform" />
                                        </Button>

                                        <!-- Check Out Button (Visible only for Checked In) -->
                                        <Button Style="{StaticResource SecondaryButton}" Padding="7,4" Margin="0,0,5,0"
                                                Command="{Binding DataContext.CheckOutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="Check Out Guest">
                                            <Path Data="{StaticResource IconCheckOut}" Fill="{StaticResource BrushWarning}" Width="11" Height="11" Stretch="Uniform" />
                                        </Button>

                                        <!-- Print Folio / Invoice Button -->
                                        <Button Style="{StaticResource SecondaryButton}" Padding="7,4" Margin="0,0,5,0"
                                                Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="View / Print Invoice Folio">
                                            <Path Data="{StaticResource IconPrint}" Fill="{StaticResource BrushPrimaryNavy}" Width="11" Height="11" Stretch="Uniform" />
                                        </Button>

                                        <!-- Edit Button -->
                                        <Button Style="{StaticResource SecondaryButton}" Padding="7,4" Margin="0,0,5,0"
                                                Command="{Binding DataContext.EditReservationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="Edit Reservation Dates/Room">
                                            <Path Data="{StaticResource IconEdit}" Fill="{StaticResource BrushPrimaryNavy}" Width="11" Height="11" Stretch="Uniform" />
                                        </Button>

                                        <!-- Cancel Button -->
                                        <Button Style="{StaticResource SecondaryButton}" Padding="7,4"
                                                Command="{Binding DataContext.CancelReservationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="Cancel Reservation">
                                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushDanger}" Width="11" Height="11" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
