<UserControl x:Class="HotelEase.Views.RoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Controls: Search, Filters & Action Buttons -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search by Room # -->
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Tag="Search room # or floor..." />

                <!-- Filter by Room Type -->
                <ComboBox Grid.Column="2" ItemsSource="{Binding RoomTypeFilters}" 
                          SelectedItem="{Binding SelectedTypeFilter}" Style="{StaticResource ModernComboBox}" />

                <!-- Filter by Status -->
                <ComboBox Grid.Column="4" ItemsSource="{Binding RoomStatusFilters}" 
                          SelectedItem="{Binding SelectedStatusFilter}" Style="{StaticResource ModernComboBox}" />

                <!-- Action Buttons -->
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushPrimaryNavy}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleMaintenanceCommand}" Margin="0,0,8,0">
                        <TextBlock Text="Toggle Maintenance" />
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddRoomCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Add Room" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rooms DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding RoomsView}" SelectedItem="{Binding SelectedRoom}" Style="{StaticResource ModernDataGrid}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Room #" Binding="{Binding RoomNumber}" Width="100" FontWeight="SemiBold" />
                        
                        <DataGridTemplateColumn Header="Room Type" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrushAccentTeal}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RoomType}" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Floor" Binding="{Binding Floor, StringFormat={}Floor {0}}" Width="90" />
                        <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity, StringFormat={}{0} Guests}" Width="110" />
                        <DataGridTextColumn Header="Price / Night" Binding="{Binding PricePerNight, Converter={StaticResource CurrencyConverter}}" Width="120" FontWeight="SemiBold" />
                        
                        <DataGridTemplateColumn Header="Current Status" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left"
                                            Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToForegroundConverter}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Description &amp; Amenities" Binding="{Binding Description}" Width="*" />

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="Actions" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditRoomCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Path Data="{StaticResource IconEdit}" Fill="{StaticResource BrushPrimaryNavy}" Width="11" Height="11" Stretch="Uniform" />
                                        </Button>

                                        <Button Style="{StaticResource SecondaryButton}" Padding="8,4"
                                                Command="{Binding DataContext.DeleteRoomCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Path Data="{StaticResource IconDelete}" Fill="{StaticResource BrushDanger}" Width="11" Height="11" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
