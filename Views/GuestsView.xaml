<UserControl x:Class="HotelEase.Views.GuestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Controls: Search & Action Buttons -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Tag="Search by name, phone, email, or guest ID..." />

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushPrimaryNavy}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddGuestCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Register Guest" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Guests DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding GuestsView}" SelectedItem="{Binding SelectedGuest}" Style="{StaticResource ModernDataGrid}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Guest ID" Binding="{Binding GuestId, StringFormat={}#GST-{0:D4}}" Width="90" FontWeight="SemiBold" />
                        
                        <DataGridTemplateColumn Header="Full Name" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource BrushAccentTealSoft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconGuests}" Fill="{StaticResource BrushAccentTeal}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Phone Number" Binding="{Binding Phone}" Width="140" />
                        <DataGridTextColumn Header="Email Address" Binding="{Binding Email}" Width="180" />
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*" />
                        <DataGridTextColumn Header="ID Reference" Binding="{Binding IdReference}" Width="130" />
                        <DataGridTextColumn Header="Bookings" Binding="{Binding TotalBookings, StringFormat={}{0} stays}" Width="90" FontWeight="Medium" />

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="Actions" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ViewHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="View Stay History">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconCalendar}" Fill="{StaticResource BrushPrimaryNavy}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="History" FontSize="11" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditGuestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Path Data="{StaticResource IconEdit}" Fill="{StaticResource BrushPrimaryNavy}" Width="11" Height="11" Stretch="Uniform" />
                                        </Button>

                                        <Button Style="{StaticResource SecondaryButton}" Padding="8,4"
                                                Command="{Binding DataContext.DeleteGuestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Path Data="{StaticResource IconDelete}" Fill="{StaticResource BrushDanger}" Width="11" Height="11" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
