<Window x:Class="HotelEase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:HotelEase.Views"
        xmlns:viewmodels="clr-namespace:HotelEase.ViewModels"
        mc:Ignorable="d"
        Title="HotelEase — Hotel Room Booking &amp; Management System" 
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushCanvasBackground}">

    <Window.Resources>
        <!-- DataTemplates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:RoomsViewModel}">
            <views:RoomsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:GuestsViewModel}">
            <views:GuestsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ReservationsViewModel}">
            <views:ReservationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CheckInCheckOutViewModel}">
            <views:CheckInCheckOutView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PaymentsViewModel}">
            <views:PaymentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="250" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- 1. LEFT SIDEBAR NAVIGATION PANEL               -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="{StaticResource BrushPrimaryNavyDark}">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Items -->
                    <RowDefinition Height="*" />
                    <!-- Footer Info -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand / Logo Area -->
                <Border Grid.Row="0" Padding="20,24,20,20" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Hotel Logo Icon Badge -->
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{StaticResource BrushAccentTeal}" Margin="0,0,12,0">
                            <Path Data="{StaticResource IconHotel}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="HotelEase" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Management System" FontSize="11" Foreground="#94A3B8" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
                    <StackPanel>
                        <TextBlock Text="MAIN MENU" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="24,10,0,8" />

                        <!-- 1. Dashboard -->
                        <RadioButton Style="{StaticResource SidebarNavButton}" IsChecked="True"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDashboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 2. Room Management -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Rooms">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconBed}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Room Inventory" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 3. Guest Management -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Guests">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGuests}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Guest Registry" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 4. Reservations -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Reservations">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCalendar}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Reservations" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="OPERATIONS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="24,18,0,8" />

                        <!-- 5. Check-in / Check-out -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Command="{Binding NavigateCommand}" CommandParameter="CheckInCheckOut">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCheckIn}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Front Desk (In/Out)" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 6. Payments and Billing -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Payments">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPayments}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Billing &amp; Payments" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 7. Reports -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Reports">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReports}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Reports &amp; Analytics" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="24,18,0,8" />

                        <!-- 8. Settings / About -->
                        <RadioButton Style="{StaticResource SidebarNavButton}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Settings &amp; Database" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer: Status & Active Session -->
                <Border Grid.Row="2" Background="#0A0F1D" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#1E293B" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconGuests}" Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Reception Desk" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="SQLite Connected" FontSize="10" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- 2. MAIN WORKSPACE AREA                         -->
        <!-- ============================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Navigation & Action Header -->
                <RowDefinition Height="Auto" />
                <!-- Dynamic Page Content -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Title & Subtitle -->
                        <ColumnDefinition Width="*" />
                        <!-- Clock & Quick Action Buttons -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource TextHeader1}" />
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource TextSubtitle}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Live Time Indicator -->
                        <Border Background="{StaticResource BrushSurfaceMuted}" CornerRadius="6" Padding="12,7" Margin="0,0,14,0">
                            <TextBlock Text="{Binding CurrentDateTime}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" />
                        </Border>

                        <!-- Quick "+ New Booking" Button -->
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding QuickNewBookingCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="New Booking" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Global Refresh Button -->
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAllCommand}" ToolTip="Refresh active workspace data">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushPrimaryNavy}" Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- View Workspace Content Host -->
            <Border Grid.Row="1" Padding="24">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>
        </Grid>
    </Grid>
</Window>
