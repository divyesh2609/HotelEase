<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Palette (Navy & Teal) -->
    <Color x:Key="ColorPrimaryNavyDark">#0F172A</Color>
    <Color x:Key="ColorPrimaryNavy">#1E293B</Color>
    <Color x:Key="ColorPrimaryNavyLight">#334155</Color>

    <Color x:Key="ColorAccentTeal">#0D9488</Color>
    <Color x:Key="ColorAccentTealHover">#0F766E</Color>
    <Color x:Key="ColorAccentTealLight">#14B8A6</Color>
    <Color x:Key="ColorAccentTealSoft">#CCFBF1</Color>

    <!-- Backgrounds & Neutral Surfaces -->
    <Color x:Key="ColorCanvasBackground">#F8FAFC</Color>
    <Color x:Key="ColorCardBackground">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceMuted">#F1F5F9</Color>
    <Color x:Key="ColorBorder">#E2E8F0</Color>
    <Color x:Key="ColorBorderDark">#CBD5E1</Color>

    <!-- Typography -->
    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextSecondary">#475569</Color>
    <Color x:Key="ColorTextMuted">#94A3B8</Color>
    <Color x:Key="ColorTextWhite">#FFFFFF</Color>

    <!-- Status Accents -->
    <Color x:Key="ColorSuccess">#059669</Color>
    <Color x:Key="ColorSuccessBg">#ECFDF5</Color>
    <Color x:Key="ColorWarning">#D97706</Color>
    <Color x:Key="ColorWarningBg">#FFFBEB</Color>
    <Color x:Key="ColorDanger">#E11D48</Color>
    <Color x:Key="ColorDangerBg">#FFF1F2</Color>
    <Color x:Key="ColorInfo">#0284C7</Color>
    <Color x:Key="ColorInfoBg">#F0F9FF</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BrushPrimaryNavyDark" Color="{StaticResource ColorPrimaryNavyDark}" />
    <SolidColorBrush x:Key="BrushPrimaryNavy" Color="{StaticResource ColorPrimaryNavy}" />
    <SolidColorBrush x:Key="BrushPrimaryNavyLight" Color="{StaticResource ColorPrimaryNavyLight}" />

    <SolidColorBrush x:Key="BrushAccentTeal" Color="{StaticResource ColorAccentTeal}" />
    <SolidColorBrush x:Key="BrushAccentTealHover" Color="{StaticResource ColorAccentTealHover}" />
    <SolidColorBrush x:Key="BrushAccentTealLight" Color="{StaticResource ColorAccentTealLight}" />
    <SolidColorBrush x:Key="BrushAccentTealSoft" Color="{StaticResource ColorAccentTealSoft}" />

    <SolidColorBrush x:Key="BrushCanvasBackground" Color="{StaticResource ColorCanvasBackground}" />
    <SolidColorBrush x:Key="BrushCardBackground" Color="{StaticResource ColorCardBackground}" />
    <SolidColorBrush x:Key="BrushSurfaceMuted" Color="{StaticResource ColorSurfaceMuted}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderDark" Color="{StaticResource ColorBorderDark}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextWhite" Color="{StaticResource ColorTextWhite}" />

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushSuccessBg" Color="{StaticResource ColorSuccessBg}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushWarningBg" Color="{StaticResource ColorWarningBg}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushDangerBg" Color="{StaticResource ColorDangerBg}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" />
    <SolidColorBrush x:Key="BrushInfoBg" Color="{StaticResource ColorInfoBg}" />

</ResourceDictionary>
